-- Hàm tạo nút bấm tính năng
local function createButton(name, order)
    local btn = Instance.new("TextButton")
    btn.Name = name .. "Btn"
    btn.Parent = Container
    btn.BackgroundColor3 = Color3.fromRGB(20, 20, 28)
    btn.Size = UDim2.new(1, -10, 0, 42)
    btn.Font = Enum.Font.GothamSemibold
    btn.Text = "   " .. name
    btn.TextColor3 = Color3.fromRGB(240, 240, 240)
    btn.TextSize = 14
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.LayoutOrder = order
    btn.AutoButtonColor = false

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = btn

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(40, 40, 60)
    stroke.Thickness = 1
    stroke.Parent = btn

    local dot = Instance.new("Frame")
    dot.Name = "StatusDot"
    dot.Parent = btn
    dot.BackgroundColor3 = Color3.fromRGB(120, 120, 120)
    dot.Position = UDim2.new(1, -30, 0.5, -6)
    dot.Size = UDim2.new(0, 12, 0, 12)
    
    local dotCorner = Instance.new("UICorner")
    dotCorner.CornerRadius = UDim.new(1, 0)
    dotCorner.Parent = dot

    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(30, 30, 45)}):Play()
        TweenService:Create(stroke, TweenInfo.new(0.2), {Color3 = Color3.fromRGB(255, 255, 255)}):Play()
    end)

    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(20, 20, 28)}):Play()
        TweenService:Create(stroke, TweenInfo.new(0.2), {Color3 = Color3.fromRGB(40, 40, 60)}):Play()
    end)

    return btn, dot
end

