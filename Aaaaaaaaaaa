-- 1. FIX LAG
local fixLagBtn, fixLagDot = createButton("Fix Lag (Boost FPS)", 1)
local fixLagActive = false
fixLagBtn.MouseButton1Click:Connect(function()
    fixLagActive = not fixLagActive
    fixLagDot.BackgroundColor3 = fixLagActive and Color3.fromRGB(0, 255, 100) or Color3.fromRGB(120, 120, 120)
    
    if fixLagActive then
        for _, v in pairs(workspace:GetDescendants()) do
            if v:IsA("Part") or v:IsA("MeshPart") then
                v.Material = Enum.Material.SmoothPlastic
                v.Reflectance = 0
            elseif v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Fire") then
                v.Enabled = false
            end
        end
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
    end
end)

